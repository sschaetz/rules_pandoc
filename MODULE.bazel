"""rules_pandoc"""

module(
    name = "rules_pandoc",
    version = "0.0.0",
)

# Platform constraints referenced by the generated toolchains.
bazel_dep(name = "platforms", version = "1.0.0")

# Provides string_flag, used by //pandoc/settings for version selection.
bazel_dep(name = "bazel_skylib", version = "1.8.2")

# Supplies the typst binary used as the PDF engine by pandoc_pdf. The typst
# archive is only fetched when a pandoc_pdf target is actually built.
bazel_dep(name = "rules_typst", version = "0.2.0")
archive_override(
    module_name = "rules_typst",
    integrity = "sha256-ORfuZ1ic1akNhnamahY8l7BzHdGmmxOz18PVJEG0MQY=",
    urls = ["https://github.com/periareon/rules_typst/releases/download/0.2.0/rules_typst-0.2.0.tar.gz"],
)

pandoc = use_extension("//pandoc:extensions.bzl", "pandoc")
use_repo(
    pandoc,
    "pandoc_toolchains",
)

register_toolchains(
    "@pandoc_toolchains//:all",
)

# Provides py_binary for //tools/update_versions (maintainer-only tooling).
bazel_dep(name = "rules_venv", version = "0.10.0", dev_dependency = True)
