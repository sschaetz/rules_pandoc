load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

# Exposed to //docs so Stardoc can document the public shims. bzl_library uses
# bazel_skylib (a regular dep), so loading this package stays consumer-safe --
# unlike the @stardoc rule, which is a dev dependency and must live in //docs.
exports_files(
    [
        "pandoc.bzl",
        "pandoc_pdf.bzl",
    ],
    visibility = ["//docs:__pkg__"],
)

bzl_library(
    name = "pandoc_shim",
    srcs = ["pandoc.bzl"],
    visibility = ["//docs:__pkg__"],
    deps = ["//pandoc/private:pandoc_bzl"],
)

bzl_library(
    name = "pandoc_pdf_shim",
    srcs = ["pandoc_pdf.bzl"],
    visibility = ["//docs:__pkg__"],
    deps = ["//pandoc/private:pandoc_bzl"],
)
