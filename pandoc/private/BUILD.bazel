# Implementation details for rules_pandoc. Not part of the public API.

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

# bzl_library targets let Stardoc (driven from //pandoc) resolve the loads when
# documenting the public shims. Visible to //pandoc only.
bzl_library(
    name = "toolchain_bzl",
    srcs = ["toolchain.bzl"],
    visibility = ["//pandoc:__subpackages__"],
)

bzl_library(
    name = "pandoc_bzl",
    srcs = ["pandoc.bzl"],
    visibility = ["//pandoc:__subpackages__"],
    deps = [":toolchain_bzl"],
)
