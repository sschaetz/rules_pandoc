load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("//pandoc/private:versions.bzl", "PANDOC_VERSIONS")

# Select the active pandoc version with:
#   --@rules_pandoc//pandoc/settings:version=<version>
#
# TODO: set build_setting_default to a version present in versions.bzl once
# PANDOC_VERSIONS is populated.
string_flag(
    name = "version",
    build_setting_default = "3.10",
    values = PANDOC_VERSIONS.keys(),
    visibility = ["//visibility:public"],
)

[
    config_setting(
        name = "version_{}".format(version),
        flag_values = {":version": version},
        visibility = ["//visibility:public"],
    )
    for version in PANDOC_VERSIONS.keys()
]
